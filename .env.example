# Copy this file to .env and fill in your values
PORT=5000

# ---------------------------------------------------------------------------
# Gemini API Key(s)
# Get keys at https://ai.google.dev/gemini-api/docs/api-key
# Leave blank to run in Simulation Mode (fully functional without a key)
# ---------------------------------------------------------------------------

# Option 1: Single key (legacy, backward compatible)
GEMINI_API_KEY=

# Option 2: Multiple keys — comma-separated pool for round-robin rotation
# Automatically eliminates rate limit (RPD/TPM) errors across keys
GEMINI_API_KEYS=


# Option 3: Indexed keys
# GEMINI_API_KEY_1=AIzaSy...key1
# GEMINI_API_KEY_2=AIzaSy...key2
# GEMINI_API_KEY_3=AIzaSy...key3

# ---------------------------------------------------------------------------
# Gemini Model & Token Settings
# ---------------------------------------------------------------------------

# Model to use (default: gemini-3.6-flash)
# Other options: gemini-1.5-flash, gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.6-flash

# Maximum output tokens per LLM call (default: 2048)
GEMINI_MAX_OUTPUT_TOKENS=2048

# ---------------------------------------------------------------------------
# Rate Limit & Retry Configuration
# ---------------------------------------------------------------------------

# Maximum number of retry attempts on HTTP 429 rate limit errors (default: 5)
LLM_MAX_RETRIES=5

# Base seconds for exponential backoff: wait = BASE * 2^attempt (default: 2.0)
LLM_BACKOFF_BASE_SEC=2.0

# ---------------------------------------------------------------------------
# External APIs
# Groq API Key (supports 1 key or multiple comma-separated keys for auto-rotation: key1,key2,key3)
GROQ_API_KEY=key1,key2,key3
GROQ_MODEL=openai/gpt-oss-20b
# ---------------------------------------------------------------------------

# OpenWeatherMap API Key for live weather advisories
WEATHER_API_KEY=

# Google Calendar OAuth credentials (optional, for external calendar sync)
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5000/auth/google/callback
